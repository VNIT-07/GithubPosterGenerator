# ==============================================================================
# GitHub Profile Poster Generator — Environment Variables
# ==============================================================================

# 1. GitHub API Personal Access Token (Optional but Recommended)
# Increases rate limits from 60 requests/hour to 5,000 requests/hour.
# Generate a classic token with no special scopes at: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=your_github_personal_access_token

# 2. Upstash Redis (Required for Real-Time Live Visitor Counter across instances)
# Create a free Redis database at: https://console.upstash.com/
# Copy the REST URL and REST Token from the database dashboard details.
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# (Vercel KV alternative keys are also supported automatically):
# KV_REST_API_URL=https://your-kv-id.upstash.io
# KV_REST_API_TOKEN=your_kv_token
